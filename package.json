{
  "name": "dsh-usage-aggregator",
  "version": "0.4.0",
  "private": true,
  "description": "DSH 聚合插件：把多件能力收进一个插件 —— 插件管理器只占一行、设置面板只占一个入口，功能持续增补。 · One DSH plugin that bundles multiple capabilities behind a single Plugin Manager row and a single Settings entry, and keeps growing.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "quota",
    "theme",
    "axzo",
    "plugin",
    "update"
  ],
  "license": "MIT",
  "author": "gaozhipeng",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./preset-guard": "./presets/hard-metrics-guard.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/host",
    "client/client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "presets",
    "README.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/hard-metrics.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch --mode watch",
    "dev": "vite",
    "check": "bash scripts/verify.sh",
    "check:host": "node scripts/check-host.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:renewal": "node scripts/smoke-renewal.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "ui-check:expander": "node scripts/ui-check-expander.mjs",
    "ui-check:tasks": "node scripts/ui-check-tasks.mjs",
    "render-check": "node scripts/render-check.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "js-yaml": "^4.3.2"
  }
}
